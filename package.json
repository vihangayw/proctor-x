{
  "name": "ProctorX",
  "productName": "ProctorX",
  "version": "1.0.1",
  "description": "Electron application for online exams",
  "author": "Your Name <your.email@example.com>",
  "license": "ISC",
  "homepage": "https://your-company.com/exam-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/exam-application.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/exam-application/issues"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "node scripts/check-mac-codesign.js && node scripts/ensure-apple-intermediate-certs.js && node scripts/prepare-mac-keychain-for-codesign.js && electron-builder build --mac dir && node scripts/build-mac-dmg.js",
    "mac:setup-codesign-once": "node scripts/mac-setup-codesign-once.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:all": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "com.cps.proctorx",
    "productName": "ProctorX",
    "copyright": "Copyright © 2025 CPS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist",
      "!dist1",
      "!dist/**/*",
      "!dist1/**/*",
      "!*.md",
      "!**/node_modules/electron",
      "!**/node_modules/electron/**",
      "!**/node_modules/electron-builder",
      "!**/node_modules/electron-builder/**",
      "!**/node_modules/app-builder-bin",
      "!**/node_modules/app-builder-bin/**",
      "!**/node_modules/electron-winstaller",
      "!**/node_modules/electron-winstaller/**",
      "!**/node_modules/typescript",
      "!**/node_modules/typescript/**",
      "!**/node_modules/7zip-bin",
      "!**/node_modules/7zip-bin/**",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}",
      "!node_modules/**/*.map",
      "!node_modules/**/*.ts",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/__tests__/**",
      "!node_modules/**/examples/**",
      "!node_modules/**/docs/**",
      "!node_modules/**/*.md"
    ],
    "asar": true,
    "electronLanguages": [
      "en"
    ],
    "afterSign": "scripts/notarize.js",
    "protocols": [
      {
        "name": "ProctorX",
        "schemes": [
          "proctorx"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dir",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "gatekeeperAssess": true,
      "identity": "BF1405DE5526BB8249B59D3B3B250031818F9213",
      "signIgnore": [
        "locale\\.pak$"
      ]
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "format": "ULFO",
      "iconSize": 120,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },

    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "forceCodeSigning": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "vyasith@gmail.com",
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "livekit-client": "^2.15.8",
    "sweetalert2": "^11.26.3"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "electron": "^37.2.1",
    "electron-builder": "^26.0.12"
  }
}