{
  "name": "ProctorX",
  "productName": "ProctorX",
  "version": "1.0.0",
  "description": "Electron application for online exams",
  "author": "Your Name <your.email@example.com>",
  "license": "ISC",
  "homepage": "https://your-company.com/exam-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/exam-application.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/exam-application/issues"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --mac --windows --linux",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.cps.proctorx",
    "productName": "Proctor X",
    "copyright": "Copyright © 2025 CPS",
    "directories": {
      "output": "dist"
    },
    "protocols": [
      {
        "name": "Proctor X",
        "schemes": [
          "proctorx"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "maintainer": "your-email@example.com",
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.3"
  },
  "devDependencies": {
    "electron": "^37.2.1",
    "electron-builder": "^26.0.12"
  }
}
